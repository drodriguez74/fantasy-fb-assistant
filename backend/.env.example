# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fantasy_football_db

# Security
SECRET_KEY=your-secret-key-here

# CORS -- optional. Defaults to the frontend's local dev URLs, so local dev
# needs no config here. In production, set this to your real deployed
# frontend URL(s), comma-separated:
# CORS_ORIGINS=https://your-frontend.vercel.app

# Redis
REDIS_URL=redis://localhost:6379

# AI Services
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Fantasy Platform APIs
ESPN_CLIENT_ID=your-espn-client-id
ESPN_CLIENT_SECRET=your-espn-client-secret
YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret

# External APIs
SLEEPER_API_URL=https://api.sleeper.app/v1

# FantasyPros Consensus Rankings/ADP API (optional -- third consensus-ranking
# source; app degrades to Sleeper/ESPN-only when unset). Request a free key
# at https://secure.fantasypros.com/api-keys/request/
FANTASYPROS_API_KEY=your-fantasypros-api-key

# Outbound email (SMTP) -- optional. Used by email_service.py to send real
# verification/password-reset emails from auth.py. Leave all of these unset
# and the app stays in its honest dev-log mode: emails are logged instead of
# sent (no crash, no silent failure). Set all five together to enable real
# sending; e.g. for Gmail, SMTP_USERNAME is the full address and
# SMTP_PASSWORD is an app password (not your account password).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@fantasyfootball.com
