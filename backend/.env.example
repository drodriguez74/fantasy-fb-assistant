# Database -- required. Any standard Postgres connection string works: a
# local Postgres (e.g. docker-compose's `db` service) or a hosted instance
# like Supabase. For Supabase specifically, use the connection-pooler string
# from Project Settings -> Database (not the direct connection) -- verified
# working for both the running app and `alembic upgrade head`/`alembic
# current`, which read this same value via app.core.config.settings, not
# alembic.ini's own (unused-at-runtime) fallback.
DATABASE_URL=postgresql://user:password@localhost:5432/fantasy_football_db

# Security -- required. Signs JWT access tokens (python-jose).
SECRET_KEY=your-secret-key-here

# CORS -- optional. Defaults to the frontend's local dev URLs, so local dev
# needs no config here. In production, set this to your real deployed
# frontend URL(s), comma-separated:
# CORS_ORIGINS=https://your-frontend.vercel.app

# AI Services -- optional, but at least one is needed for the AI-backed
# content types (player_analysis, injury_report) and consensus
# recommendations to actually call a model instead of degrading; both are
# wired through ai_service.py's OpenAI<->Anthropic fallback, so either or
# both work.
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Yahoo Fantasy OAuth app credentials -- optional, needed only for the
# "Connect Yahoo League" flow (yahoo_service.py). ESPN and Sleeper need no
# app-level credentials: ESPN auth is a per-user SWID/espn_s2 cookie pair
# pasted through POST /leagues/espn/connect, and Sleeper needs none at all
# (its player/draft data is public).
YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret

# Yahoo OAuth redirect URI -- optional, defaults to
# http://localhost:3001/yahoo/callback. Yahoo's app console rejects plain
# http:// redirect URIs outright (confirmed live: "URI must be https.",
# no localhost/127.0.0.1 exception), so local Yahoo testing needs an HTTPS
# tunnel (e.g. `ngrok http 3001`) registered as a Redirect URI in Yahoo's
# app console, with that same URL set here:
# YAHOO_REDIRECT_URI=https://your-tunnel.ngrok-free.app/yahoo/callback

# External APIs -- optional, has a working default. Only override if
# Sleeper's public API base URL ever changes.
# SLEEPER_API_URL=https://api.sleeper.app/v1

# FantasyPros Consensus Rankings/ADP API (optional -- third consensus-ranking
# source; app degrades to Sleeper/ESPN-only when unset). Request a free key
# at https://secure.fantasypros.com/api-keys/request/
FANTASYPROS_API_KEY=your-fantasypros-api-key

# Outbound email (SMTP) -- optional. Used by email_service.py to send real
# verification/password-reset emails from auth.py. Leave all of these unset
# and the app stays in its honest dev-log mode: emails are logged instead of
# sent (no crash, no silent failure). Set all five together to enable real
# sending; e.g. for Gmail, SMTP_USERNAME is the full address and
# SMTP_PASSWORD is an app password (not your account password).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
FROM_EMAIL=noreply@fantasyfootball.com
