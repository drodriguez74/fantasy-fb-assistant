# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fantasy_football_db

# Security
SECRET_KEY=your-secret-key-here

# Redis
REDIS_URL=redis://localhost:6379

# AI Services
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Fantasy Platform APIs
ESPN_CLIENT_ID=your-espn-client-id
ESPN_CLIENT_SECRET=your-espn-client-secret
YAHOO_CLIENT_ID=your-yahoo-client-id
YAHOO_CLIENT_SECRET=your-yahoo-client-secret

# External APIs
SLEEPER_API_URL=https://api.sleeper.app/v1

# FantasyPros Consensus Rankings/ADP API (optional -- third consensus-ranking
# source; app degrades to Sleeper/ESPN-only when unset). Request a free key
# at https://secure.fantasypros.com/api-keys/request/
FANTASYPROS_API_KEY=your-fantasypros-api-key